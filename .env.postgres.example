# Local development only. Defaults match docker-compose.yml; no Stockbit frames here.
# For custom settings, copy to .env.postgres then use:
# docker compose --env-file .env.postgres up -d --wait
PG_HOST=127.0.0.1
PG_PORT=5433
PG_USER=stockbit
PG_PASSWORD=stockbit_local
PG_DATABASE=stockbit_ws

# pgAdmin login (local development only; different from database login)
PGADMIN_PORT=5051
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=stockbit_admin_local
